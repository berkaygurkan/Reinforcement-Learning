    "# ---------------------------------------------------------------------\n",
    "# PPO baseline eğitim fonksiyonları (SB3 + VecNormalize + Checkpoint)\n",
    "# ---------------------------------------------------------------------\n",
    "def train_single_task_ppo(\n",
    "    total_timesteps: int,\n",
    "    fixed_mass_scale: float = 1.0,\n",
    "    n_envs: int = 8,\n",
    "    log_dir: str = \"./logs_single_task\",\n",
    "    save_freq: int = 50000\n",
    ") -> Tuple[PPO, VecNormalize]:\n",
    "    os.makedirs(log_dir, exist_ok=True)\n",
    "\n",
    "    # Env oluşturma (TimeLimit düzeltildi) ve Normalize etme\n",
    "    env_fn = make_single_task_env(fixed_mass_scale=fixed_mass_scale, max_steps=200)\n",
    "    env = make_vec_env(env_fn, n_envs=n_envs, seed=SEED)\n",
    "    env = VecNormalize(env, norm_obs=True, norm_reward=True, clip_obs=10.)\n",
    "\n",
    "    # Checkpoint Callback\n",
    "    checkpoint_callback = CheckpointCallback(\n",
    "        save_freq=max(save_freq // n_envs, 1),\n",
    "        save_path=os.path.join(log_dir, \"checkpoints\"),\n",
    "        name_prefix=\"ppo_single\"\n",
    "    )\n",
    "\n",
    "    model = PPO(\n",
    "        \"MlpPolicy\",\n",
    "        env,\n",
    "        verbose=1,\n",
    "        seed=SEED,\n",
    "        tensorboard_log=log_dir,\n",
    "        n_steps=2048,\n",
    "        batch_size=64,\n",
    "        gae_lambda=0.95,\n",
    "        gamma=0.99,\n",
    "        n_epochs=10,\n",
    "        clip_range=0.2,\n",
    "        learning_rate=3e-4,\n",
    "        device=device\n",
    "    )\n",
    "\n",
    "    model.learn(total_timesteps=total_timesteps, callback=checkpoint_callback)\n",
    "    \n",
    "    # Modeli ve Normalize istatistiklerini kaydet\n",
    "    model.save(os.path.join(log_dir, \"final_model\"))\n",
    "    env.save(os.path.join(log_dir, \"vec_normalize.pkl\"))\n",
    "    \n",
    "    return model, env\n",
    "\n",
    "\n",
    "def train_multi_task_ppo(\n",
    "    total_timesteps: int,\n",
    "    n_envs: int = 8,\n",
    "    log_dir: str = \"./logs_multi_task\",\n",
    "    save_freq: int = 50000\n",
    ") -> Tuple[PPO, VecNormalize]:\n",
    "    os.makedirs(log_dir, exist_ok=True)\n",
    "\n",
    "    env_fn = make_multi_task_env(max_steps=200)\n",
    "    env = make_vec_env(env_fn, n_envs=n_envs, seed=SEED)\n",
    "    env = VecNormalize(env, norm_obs=True, norm_reward=True, clip_obs=10.)\n",
    "\n",
    "    checkpoint_callback = CheckpointCallback(\n",
    "        save_freq=max(save_freq // n_envs, 1),\n",
    "        save_path=os.path.join(log_dir, \"checkpoints\"),\n",
    "        name_prefix=\"ppo_multi\"\n",
    "    )\n",
    "\n",
    "    model = PPO(\n",
    "        \"MlpPolicy\",\n",
    "        env,\n",
    "        verbose=1,\n",
    "        seed=SEED,\n",
    "        tensorboard_log=log_dir,\n",
    "        n_steps=2048,\n",
    "        batch_size=64,\n",
    "        gae_lambda=0.95,\n",
    "        gamma=0.99,\n",
    "        n_epochs=10,\n",
    "        clip_range=0.2,\n",
    "        learning_rate=3e-4,\n",
    "        device=device\n",
    "    )\n",
    "\n",
    "    model.learn(total_timesteps=total_timesteps, callback=checkpoint_callback)\n",
    "    \n",
    "    model.save(os.path.join(log_dir, \"final_model\"))\n",
    "    env.save(os.path.join(log_dir, \"vec_normalize.pkl\"))\n",
    "    \n",
    "    return model, env\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# PPO evaluate fonksiyonu (VecNormalize destekli)\n",
    "# ---------------------------------------------------------------------\n",
    "def evaluate_ppo_on_mass_scales(\n",
    "    model: PPO,\n",
    "    training_env: VecNormalize, # Eğitimden dönen normalize env gerekli\n",
    "    mass_scales: List[float],\n",
    "    n_eval_episodes: int = 10,\n",
    "    deterministic: bool = True,\n",
    ") -> Dict[float, Tuple[float, float]]:\n",
    "    \n",
    "    results: Dict[float, Tuple[float, float]] = {}\n",
    "    \n",
    "    # Normalize ayarlarını test moduna çek (update yok, reward normalize yok)\n",
    "    training_env.training = False\n",
    "    training_env.norm_reward = False\n",
    "    \n",
    "    for scale in mass_scales:\n",
    "        # Yeni bir single task ortamı yarat\n",
    "        env_fn = make_single_task_env(fixed_mass_scale=scale, max_steps=200)\n",
    "        \n",
    "        # Değerlendirme ortamını da VecNormalize ile sarıyoruz\n",
    "        eval_env = make_vec_env(env_fn, n_envs=1, seed=SEED)\n",
    "        eval_env = VecNormalize(eval_env, norm_obs=True, norm_reward=False, clip_obs=10.)\n",
    "        \n",
    "        # Eğitim istatistiklerini (moving average, var) kopyala!\n",
    "        eval_env.obs_rms = training_env.obs_rms\n",
    "        eval_env.ret_rms = training_env.ret_rms\n",
    "        eval_env.training = False # İstatistikleri güncelleme\n",
    "\n",
    "        mean_reward, std_reward = evaluate_policy(\n",
    "            model,\n",
    "            eval_env,\n",
    "            n_eval_episodes=n_eval_episodes,\n",
    "            deterministic=deterministic,\n",
    "            render=False,\n",
    "        )\n",
    "\n",
    "        results[scale] = (float(mean_reward), float(std_reward))\n",
    "        eval_env.close()\n",
    "\n",
    "        print(\n",
    "            f\"[PPO EVAL] mass_scale={scale:.2f} | \"\n",
    "            f\"mean_return={mean_reward:.2f} ± {std_reward:.2f}\"\n",
    "        )\n",
    "\n",
    "    return results"
   ]
